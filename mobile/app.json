{
  "expo": {
    "name": "Trimly",
    "slug": "trimly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/trimly-app-icon.png",
    "scheme": "trimly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/trimly-app-icon.png",
      "bundleIdentifier": "com.trimly.app"
    },
    "android": {
      "icon": "./assets/images/trimly-app-icon.png",
      "package": "com.trimly.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F0E5",
          "image": "./assets/images/trimly-splash.png",
          "imageWidth": 941,
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trimly, sana yakın işletmeleri göstermek için konumunu kullanır."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trimly, profil fotoğrafını seçebilmen için fotoğraflarına erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Trimly, müşterinin izniyle tıraş fotoğrafı çekmek için kameraya erişir.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d924f74b-c6bc-48b9-8d00-c32229c4fdd2"
      }
    },
    "owner": "trimly-app"
  }
}
