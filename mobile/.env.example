# Fiziksel telefonda Mac'in aynı Wi-Fi ağındaki IP adresini kullan.
# Örnek: EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Android development/production build'lerinde Google Maps SDK icin gereklidir.
# Anahtari Google Cloud'da Android package + SHA-1 ile sinirlandir.
GOOGLE_MAPS_API_KEY=
