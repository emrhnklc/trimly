enum AppointmentStatus {
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentChangeProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum NoShowCaseStatus {
  PENDING_DISPUTE
  UNDER_REVIEW
  CONFIRMED
  REVOKED
}

enum BookingRestrictionScope {
  BARBERSHOP
  PLATFORM
}

enum BusinessReliabilityActionType {
  WARNING
  MEMBER_REVIEW_HOLD
  DISCOVERY_DEMOTION
  BOOKING_SUSPENSION
  MANUAL_REVIEW
}

enum BusinessCancellationPointReason {
  MORE_THAN_24_HOURS
  BETWEEN_6_AND_24_HOURS
  BETWEEN_2_AND_6_HOURS
  // Legacy reason kept so existing audit events remain readable.
  BETWEEN_2_AND_24_HOURS
  LESS_THAN_2_HOURS
  AFTER_START
  CUSTOMER_ARRIVED
}

enum BusinessCancellationAppealStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum BusinessCancellationExemptionReason {
  PLATFORM_OUTAGE
  FORCE_MAJEURE
  VERIFIED_ERROR
}

model Appointment {
  id                      String            @id @default(cuid())
  barbershopId            String
  customerId              String
  dependentProfileId      String?
  guardianPrivatePhotoConsentAt DateTime?
  attendeeNameSnapshot    String
  appointmentLocalDate    DateTime          @db.Date
  businessMemberId        String
  serviceId               String
  campaignId              String?
  campaignTitleSnapshot   String?
  campaignBenefitSnapshot String?
  serviceNameSnapshot     String
  originalPriceSnapshot   Decimal           @db.Decimal(10, 2)
  discountAmount          Decimal           @default(0) @db.Decimal(10, 2)
  priceSnapshot           Decimal           @db.Decimal(10, 2)
  durationMinutes         Int
  startsAt                DateTime
  endsAt                  DateTime
  status                  AppointmentStatus @default(CONFIRMED)
  cancelledAt             DateTime?
  cancellationReason      String?
  arrivedAt               DateTime?
  autoCompleteAt          DateTime?
  reminder24hSentAt       DateTime?
  reminder2hSentAt        DateTime?
  completedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  barbershop       Barbershop                  @relation(fields: [barbershopId], references: [id])
  customer         User                        @relation(fields: [customerId], references: [id])
  dependentProfile DependentProfile?           @relation(fields: [dependentProfileId], references: [id], onDelete: Restrict)
  businessMember   BusinessMember              @relation(fields: [businessMemberId], references: [id])
  service          Service                     @relation(fields: [serviceId], references: [id])
  campaign         Campaign?                   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  haircutRecord    HaircutRecord?
  review           AppointmentReview?
  notifications    AppNotification[]
  changeProposals  AppointmentChangeProposal[]
  noShowCase       AppointmentNoShowCase?
  businessCancellation BusinessCancellationEvent?

  @@index([barbershopId, startsAt])
  @@index([customerId, startsAt])
  @@index([customerId, appointmentLocalDate])
  @@index([dependentProfileId, appointmentLocalDate])
  @@index([businessMemberId, startsAt])
  @@index([campaignId, customerId, status])
  @@index([status, autoCompleteAt])
}

model BusinessCancellationEvent {
  id               String   @id @default(cuid())
  appointmentId    String   @unique
  barbershopId     String
  businessMemberId String
  cancelledByUserId String
  reason           String
  cancelledAt      DateTime
  minutesBeforeStart Int
  points           Int
  pointReason      BusinessCancellationPointReason
  createdAt        DateTime @default(now())
  appealStatus     BusinessCancellationAppealStatus @default(NOT_REQUESTED)
  appealReason     String?
  appealRequestedAt DateTime?
  appealRequestedByUserId String?
  appealReviewedAt DateTime?
  appealReviewedByUserId String?
  appealReviewNote String?
  exemptionReason BusinessCancellationExemptionReason?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  businessMember BusinessMember @relation(fields: [businessMemberId], references: [id])
  actions BusinessReliabilityAction[]

  @@index([barbershopId, cancelledAt])
  @@index([businessMemberId, cancelledAt])
  @@index([appealStatus, appealRequestedAt])
}

model BusinessReliabilityAction {
  id String @id @default(cuid())
  type BusinessReliabilityActionType
  barbershopId String
  businessMemberId String?
  sourceEventId String
  startsAt DateTime @default(now())
  endsAt DateTime?
  resolvedAt DateTime?
  resolvedByUserId String?
  createdAt DateTime @default(now())
  thresholdPoints Int?

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  businessMember BusinessMember? @relation(fields: [businessMemberId], references: [id])
  sourceEvent BusinessCancellationEvent @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, type])
  @@index([barbershopId, type, endsAt])
  @@index([businessMemberId, type, resolvedAt])
}

model AppointmentNoShowCase {
  id                 String           @id @default(cuid())
  appointmentId      String           @unique
  customerId         String
  dependentProfileId String?
  barbershopId       String
  markedByUserId     String
  markedAt           DateTime         @default(now())
  disputeDeadline    DateTime
  status             NoShowCaseStatus @default(PENDING_DISPUTE)
  disputeReason      String?
  disputedAt         DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  reviewNote         String?
  confirmedAt        DateTime?

  appointment  Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  restrictions BookingRestriction[]

  @@index([status, disputeDeadline])
  @@index([customerId, status, markedAt])
  @@index([barbershopId, customerId, status, markedAt])
}

model BookingRestriction {
  id           String                  @id @default(cuid())
  customerId   String
  barbershopId String?
  scope        BookingRestrictionScope
  sourceCaseId String
  startsAt     DateTime                @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime                @default(now())

  sourceCase AppointmentNoShowCase @relation(fields: [sourceCaseId], references: [id], onDelete: Cascade)

  @@unique([sourceCaseId, scope])
  @@index([customerId, scope, expiresAt])
}

model AppointmentChangeProposal {
  id                       String                          @id @default(cuid())
  appointmentId            String
  createdByMemberId        String
  proposedBusinessMemberId String
  proposedServiceId        String
  proposedServiceName      String
  proposedStartsAt         DateTime
  proposedEndsAt           DateTime
  proposedDurationMinutes  Int
  proposedPrice            Decimal                         @db.Decimal(10, 2)
  reason                   String
  status                   AppointmentChangeProposalStatus @default(PENDING)
  expiresAt                DateTime
  respondedAt              DateTime?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  appointment            Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdByMember        BusinessMember @relation("AppointmentChangeProposalCreator", fields: [createdByMemberId], references: [id])
  proposedBusinessMember BusinessMember @relation("AppointmentChangeProposalProposedMember", fields: [proposedBusinessMemberId], references: [id])
  proposedService        Service        @relation(fields: [proposedServiceId], references: [id])

  @@index([appointmentId, status])
  @@index([expiresAt, status])
}
