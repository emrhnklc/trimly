enum AppointmentStatus {
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                      String            @id @default(cuid())
  barbershopId            String
  customerId              String
  businessMemberId        String
  serviceId               String
  campaignId              String?
  campaignTitleSnapshot   String?
  campaignBenefitSnapshot String?
  serviceNameSnapshot     String
  originalPriceSnapshot   Decimal           @db.Decimal(10, 2)
  discountAmount          Decimal           @default(0) @db.Decimal(10, 2)
  priceSnapshot           Decimal           @db.Decimal(10, 2)
  durationMinutes         Int
  startsAt                DateTime
  endsAt                  DateTime
  status                  AppointmentStatus @default(CONFIRMED)
  cancelledAt             DateTime?
  cancellationReason      String?
  arrivedAt               DateTime?
  autoCompleteAt          DateTime?
  reminder24hSentAt       DateTime?
  reminder2hSentAt        DateTime?
  completedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  barbershop     Barbershop         @relation(fields: [barbershopId], references: [id])
  customer       User               @relation(fields: [customerId], references: [id])
  businessMember BusinessMember     @relation(fields: [businessMemberId], references: [id])
  service        Service            @relation(fields: [serviceId], references: [id])
  campaign       Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  haircutRecord  HaircutRecord?
  review         AppointmentReview?
  notifications  AppNotification[]

  @@index([barbershopId, startsAt])
  @@index([customerId, startsAt])
  @@index([businessMemberId, startsAt])
  @@index([campaignId, customerId, status])
  @@index([status, autoCompleteAt])
}
