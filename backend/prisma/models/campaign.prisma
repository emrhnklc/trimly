enum CampaignDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CampaignType {
  PRICE_DISCOUNT
  GIFT
  LOYALTY
}

enum CampaignRewardType {
  DISCOUNT
  GIFT
}

enum CampaignLoyaltyPeriod {
  CALENDAR_MONTH
  ROLLING_DAYS
}

model Campaign {
  id                      String                 @id @default(cuid())
  barbershopId            String
  createdByMemberId       String
  title                   String
  description             String?
  campaignType            CampaignType           @default(PRICE_DISCOUNT)
  rewardType              CampaignRewardType     @default(DISCOUNT)
  discountType            CampaignDiscountType?
  discountValue           Decimal?               @db.Decimal(10, 2)
  giftDescription         String?
  requiredCompletedVisits Int?
  loyaltyPeriod           CampaignLoyaltyPeriod?
  rollingPeriodDays       Int?
  imageUrl                String?
  startsAt                DateTime
  endsAt                  DateTime
  usageLimit              Int?
  perCustomerLimit        Int                    @default(1)
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  barbershop      Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdByMember BusinessMember    @relation(fields: [createdByMemberId], references: [id])
  services        CampaignService[]
  appointments    Appointment[]

  @@index([barbershopId, isActive, startsAt, endsAt])
  @@index([createdByMemberId])
}

model CampaignService {
  campaignId String
  serviceId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([campaignId, serviceId])
  @@index([serviceId])
}
