enum BusinessRole {
  OWNER
  MANAGER
  BARBER
  APPRENTICE
}

enum BarbershopAccessMode {
  PUBLIC
  CODE_REQUIRED
}

model Barbershop {
  id                        String               @id @default(cuid())
  name                      String
  slug                      String               @unique
  description               String?
  profileImageUrl           String?
  coverImageUrl             String?
  phone                     String?
  address                   String?
  latitude                  Float?
  longitude                 Float?
  timezone                  String               @default("Europe/Istanbul")
  isDiscoverable            Boolean              @default(false)
  acceptsBookings           Boolean              @default(false)
  accessMode                BarbershopAccessMode @default(PUBLIC)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  previousWorkingHours      Json?
  workingHoursEffectiveFrom DateTime?

  members                BusinessMember[]
  services               Service[]
  workingHours           WorkingHours[]
  bookingSettings        BookingSettings?
  appointments           Appointment[]
  invitations            BusinessInvitation[]
  favorites              FavoriteBarbershop[]
  customerAccesses       CustomerBarbershopAccess[]
  customerAccessAttempts CustomerBarbershopAccessAttempt[]
  accessCode             BarbershopAccessCode?
  notifications          AppNotification[]
  galleryPhotos          BarbershopPhoto[]
  portfolioItems         BarberPortfolioItem[]
  reviews                AppointmentReview[]
  campaigns              Campaign[]
  cancellationEvents      BusinessCancellationEvent[]
  reliabilityActions      BusinessReliabilityAction[]
}

model BarbershopPhoto {
  id           String   @id @default(cuid())
  barbershopId String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  sortOrder    Int
  createdAt    DateTime @default(now())

  barbershop Barbershop                @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  favorites  FavoriteBarbershopPhoto[]

  @@unique([barbershopId, sortOrder])
  @@index([barbershopId, sortOrder])
}

model FavoriteBarbershopPhoto {
  userId    String
  photoId   String
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo BarbershopPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
  @@index([photoId])
}

model BarbershopAccessCode {
  barbershopId String   @id
  codeHash     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
}

model CustomerBarbershopAccess {
  userId       String
  barbershopId String
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@id([userId, barbershopId])
  @@index([barbershopId, revokedAt])
}

model CustomerBarbershopAccessAttempt {
  userId          String
  barbershopId    String
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @default(now())
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@id([userId, barbershopId])
  @@index([lockedUntil])
}

model FavoriteBarbershop {
  userId       String
  barbershopId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@id([userId, barbershopId])
  @@index([barbershopId])
}

model BusinessMember {
  id                        String       @id @default(cuid())
  userId                    String
  barbershopId              String
  role                      BusinessRole
  isActive                  Boolean      @default(true)
  isBookable                Boolean      @default(false)
  biography                 String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  previousWorkingHours      Json?
  workingHoursEffectiveFrom DateTime?

  user                               User                        @relation(fields: [userId], references: [id])
  barbershop                         Barbershop                  @relation(fields: [barbershopId], references: [id])
  serviceAssignments                 BusinessMemberService[]
  workingHours                       MemberWorkingHours[]
  scheduleBlocks                     MemberScheduleBlock[]
  appointments                       Appointment[]
  createdInvitations                 BusinessInvitation[]
  haircutRecords                     HaircutRecord[]
  portfolioItems                     BarberPortfolioItem[]
  reviews                            AppointmentReview[]
  createdCampaigns                   Campaign[]
  createdAppointmentChangeProposals  AppointmentChangeProposal[] @relation("AppointmentChangeProposalCreator")
  proposedAppointmentChangeProposals AppointmentChangeProposal[] @relation("AppointmentChangeProposalProposedMember")
  cancellationEvents                 BusinessCancellationEvent[]
  reliabilityActions                 BusinessReliabilityAction[]

  @@unique([userId, barbershopId])
  @@index([barbershopId, role])
}

model BusinessInvitation {
  id                String       @id @default(cuid())
  barbershopId      String
  createdByMemberId String
  tokenHash         String       @unique
  role              BusinessRole
  expiresAt         DateTime
  usedAt            DateTime?
  acceptedByUserId  String?
  revokedAt         DateTime?
  createdAt         DateTime     @default(now())

  barbershop      Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdByMember BusinessMember @relation(fields: [createdByMemberId], references: [id])
  acceptedByUser  User?          @relation(fields: [acceptedByUserId], references: [id])

  @@index([barbershopId, expiresAt])
}

model BookingSettings {
  id                          String    @id @default(cuid())
  barbershopId                String    @unique
  minBookingNoticeMinutes     Int       @default(60)
  maxBookingAdvanceDays       Int       @default(30)
  slotIntervalMinutes         Int       @default(5)
  pendingSlotIntervalMinutes  Int?
  slotIntervalEffectiveFrom   DateTime?
  customerCancellationEnabled Boolean   @default(true)
  cancellationNoticeMinutes   Int       @default(120)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
}
