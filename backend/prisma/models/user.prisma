model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerifiedAt     DateTime?
  authVersion         Int       @default(0)
  passwordHash        String
  phone               String?   @unique
  firstName           String
  lastName            String
  birthDate           DateTime?
  provinceCode        String?
  province            String?
  district            String?
  neighborhood        String?
  profileImageUrl     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  isPlatformModerator Boolean   @default(false)

  memberships                 BusinessMember[]
  customerAppointments        Appointment[]
  acceptedInvitations         BusinessInvitation[]
  favoriteBarbershops         FavoriteBarbershop[]
  favoriteBarbershopPhotos    FavoriteBarbershopPhoto[]
  customerPortfolioItems      BarberPortfolioItem[]
  favoritePortfolioItems      FavoritePortfolioItem[]
  appointmentReviews          AppointmentReview[]
  barbershopAccesses          CustomerBarbershopAccess[]
  barbershopAccessAttempts    CustomerBarbershopAccessAttempt[]
  pushDevices                 PushDevice[]
  notificationPreference      NotificationPreference?
  notifications               AppNotification[]
  emailVerificationChallenges EmailVerificationChallenge[]
  passwordResetChallenges     PasswordResetChallenge[]
  authSessions                AuthSession[]
  accountDeletionChallenges   AccountDeletionChallenge[]
  ownershipTransferChallenges OwnershipTransferChallenge[]
  dependentProfiles           DependentProfile[]
}

enum DependentRelationship {
  CHILD
  SIBLING
  DEPENDENT
}

model DependentProfile {
  id                String                @id @default(cuid())
  ownerId           String
  firstName         String
  lastName          String
  relationship      DependentRelationship
  relationshipLabel String?
  birthDate         DateTime              @db.Date
  notes             String?
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([ownerId, archivedAt])
}

model AccountDeletionChallenge {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OwnershipTransferChallenge {
  id             String    @id @default(cuid())
  currentOwnerId String
  barbershopId   String
  targetMemberId String
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  currentOwner User @relation(fields: [currentOwnerId], references: [id], onDelete: Cascade)

  @@index([currentOwnerId, barbershopId, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  deviceName   String
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastActiveAt])
}

model PasswordResetChallenge {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model EmailVerificationChallenge {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}
