model Service {
  id              String   @id @default(cuid())
  barbershopId    String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  barbershop        Barbershop              @relation(fields: [barbershopId], references: [id])
  memberAssignments BusinessMemberService[]
  appointments      Appointment[]

  @@index([barbershopId, isActive])
}

model BusinessMemberService {
  businessMemberId String
  serviceId        String
  createdAt        DateTime @default(now())

  businessMember BusinessMember @relation(fields: [businessMemberId], references: [id], onDelete: Cascade)
  service        Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([businessMemberId, serviceId])
  @@index([serviceId])
}
