DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable&schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:51215/template1?sslmode=disable&schema=public"
DATABASE_POOL_MAX="1"
NODE_ENV="development"
# Production web istemcilerinin origin'lerini virgülle ayırarak ekle.
CORS_ORIGINS=""
# Production'da dışarıdan erişilen backend URL'si; profil fotoğrafı bağlantıları için zorunludur.
PUBLIC_API_URL=""
JWT_SECRET="replace-with-a-long-random-production-secret"
EMAIL_VERIFICATION_SECRET="replace-with-an-independent-long-random-secret"
# Production'da varsayılan kapalıdır; yalnız ihtiyaç halinde true yap.
SWAGGER_ENABLED="true"

# Localde boş bırakılırsa doğrulama kodu backend terminalinde gösterilir.
# Production ortamında SMTP bilgileri zorunludur.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Trimly <no-reply@trimly.app>"
